# Copy this file to .env and fill in real values before deploying.
# Never commit .env to git.

# Resend (email delivery) — https://resend.com
RESEND_API_KEY=re_...

# Where reservation emails are sent TO (Sandy's inbox)
BREEDER_EMAIL=sandy@example.com

# The "From" address shown in emails (must be a verified Resend domain)
FROM_EMAIL=no-reply@carterfrenchbulls.com

# Keystatic (local dev only — no env vars needed for local storage mode)
# For GitHub storage mode (future), add KEYSTATIC_GITHUB_CLIENT_ID and _SECRET
