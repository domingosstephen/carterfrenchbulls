---
import Layout from '../layouts/Layout.astro';
import config from '../../site.config';
---

<Layout
  title="Delivery"
  description="Carter French Bulls serves families in the USA and Canada. Delivery options and requirements vary by location. We discuss the details personally."
>
  <section class="section">
    <div class="container">
      <div class="page-intro">
        <h1>Delivery in the USA and Canada</h1>
        <p>
          We work with families across the United States and Canada.
          Delivery options and any applicable requirements vary by location, so we discuss
          the specifics with each family directly.
        </p>
      </div>

      {config.deliveryOptions !== '{{DELIVERY_OPTIONS}}' ? (
        <div class="delivery-options">
          <h2>Your options</h2>
          <p>{config.deliveryOptions}</p>
        </div>
      ) : (
        <div class="delivery-pending-box">
          <p>
            Delivery details are confirmed with each buyer directly. Send us a message with your location
            and we will explain what is available and what it costs.
          </p>
          <a href="/contact#reserve" class="btn btn-primary">Ask about delivery</a>
        </div>
      )}

      <div class="delivery-note">
        <h2>A note on cross-border delivery</h2>
        <p>
          Bringing a puppy from the USA to Canada (or vice versa) involves specific documentation and may
          require a health certificate timed to your travel date. Rules can change, and they vary
          by destination province or state.
        </p>
        <p>
          We do not publish specific cross-border requirements here because we want you to have
          accurate, current information rather than a general statement that might not apply to your situation.
          We walk through all of this with you before you commit to anything.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container cta-row">
      <div>
        <h2>Questions about delivery?</h2>
        <p>Send us your location and we will give you the specifics.</p>
      </div>
      <a href="/contact#reserve" class="btn btn-primary">Contact us</a>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 60ch;
    margin-bottom: 48px;
  }

  .page-intro p {
    color: var(--color-stone);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .delivery-options {
    margin-bottom: 48px;
    max-width: 60ch;
  }

  .delivery-options h2 {
    margin-bottom: 12px;
  }

  .delivery-options p {
    color: var(--color-stone);
    font-size: 1.0625rem;
  }

  .delivery-pending-box {
    padding: 28px 32px;
    background: var(--color-butter);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    max-width: 560px;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .delivery-pending-box p {
    color: var(--color-stone);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .delivery-note {
    max-width: 64ch;
    padding-top: 48px;
    border-top: 1px solid var(--color-line);
  }

  .delivery-note h2 {
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  .delivery-note p {
    color: var(--color-stone);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .cta-row {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .cta-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta-row h2 { margin-bottom: 4px; }
  .cta-row p { color: var(--color-stone); font-size: 1rem; margin: 0; }
</style>
