---
import Layout from '../layouts/Layout.astro';
import RequestForm from '../components/RequestForm.astro';
import { getCollection } from 'astro:content';
import config from '../../site.config';

const puppies = await getCollection('puppies');
const availablePuppies = puppies
  .filter((p) => p.data.status === 'available')
  .map((p) => ({ slug: p.id, name: p.data.name }));
---

<Layout
  title="Contact"
  description="Send a reservation request to Carter French Bulls. We reply promptly and answer any questions you have."
>
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-main">
        <h1 id="reserve">Send a request</h1>
        <p class="contact-sub">
          Fill in the form below and we will get back to you.
          No commitment, no payment — just a conversation.
        </p>

        <RequestForm puppyOptions={availablePuppies} />
      </div>

      <aside class="contact-aside">
        <div class="contact-aside-inner">
          <h2 class="contact-aside-heading">Other ways to reach us</h2>

          {config.phone !== '{{PHONE}}' && (
            <div class="contact-method">
              <p class="contact-method-label">Text or call</p>
              <a href={`tel:${config.phone.replace(/\D/g, '')}`} class="contact-method-value">
                {config.phone}
              </a>
              <p class="contact-method-note">Text is usually faster. We are available most days.</p>
            </div>
          )}

          {config.email !== '{{EMAIL}}' && (
            <div class="contact-method">
              <p class="contact-method-label">Email</p>
              <a href={`mailto:${config.email}`} class="contact-method-value">
                {config.email}
              </a>
            </div>
          )}

        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr 340px;
      gap: 96px;
    }
  }

  .contact-sub {
    color: var(--color-stone);
    font-size: 1.0625rem;
    margin-bottom: 40px;
    max-width: 50ch;
  }

  .contact-aside-inner {
    position: sticky;
    top: 88px;
  }

  .contact-aside-heading {
    font-size: 1.0625rem;
    margin-bottom: 24px;
  }

  .contact-method {
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .contact-method-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-stone);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .contact-method-value {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    margin-bottom: 6px;
    text-underline-offset: 3px;
  }

  .contact-method-value:hover {
    text-decoration: underline;
  }

  .contact-method-note {
    font-size: 0.875rem;
    color: var(--color-stone);
    margin: 0;
  }

  .contact-trust-note {
    padding: 20px 24px;
    background: var(--color-butter);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    margin-top: 8px;
  }

  .contact-trust-note h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .contact-trust-note p {
    font-size: 0.875rem;
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0;
  }
</style>

<script>
  // Pre-fill puppy selector from URL ?puppy= param
  const params = new URLSearchParams(window.location.search);
  const puppyParam = params.get('puppy');
  if (puppyParam) {
    const sel = document.querySelector<HTMLSelectElement>('#puppy');
    if (sel) sel.value = puppyParam;
  }
</script>
