---
import config from '../../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{config.kennelName}</p>
      <p class="footer-tagline">
        Family-bred French bulldogs for loving homes<br />
        in the USA and Canada.
      </p>
      {config.phone !== '{{PHONE}}' && (
        <a href={`tel:${config.phone.replace(/\D/g, '')}`} class="footer-contact-link">
          {config.phone}
        </a>
      )}
      {config.email !== '{{EMAIL}}' && (
        <a href={`mailto:${config.email}`} class="footer-contact-link">
          {config.email}
        </a>
      )}
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-nav-col">
        <p class="footer-nav-heading">Puppies</p>
        <a href="/puppies" class="footer-nav-link">Available puppies</a>
        <a href="/health" class="footer-nav-link">Health guarantee</a>
        <a href="/delivery" class="footer-nav-link">Delivery</a>
      </div>
      <div class="footer-nav-col">
        <p class="footer-nav-heading">Us</p>
        <a href="/about" class="footer-nav-link">About Sandy</a>
        <a href="/how-it-works" class="footer-nav-link">How it works</a>
        <a href="/contact" class="footer-nav-link">Contact</a>
        <a href="/legal" class="footer-nav-link">Privacy &amp; terms</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-legal">
        &copy; {year} {config.kennelName}. All rights reserved.
      </p>
      <p class="footer-disclaimer">
        We serve families in the USA and Canada. Delivery options and import requirements vary by location. We will discuss the details with you personally.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-sand);
    border-top: 1px solid var(--color-line);
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr;
    }
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: var(--color-stone);
    line-height: 1.6;
    max-width: 34ch;
    margin-bottom: 16px;
  }

  .footer-contact-link {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
    margin-bottom: 4px;
    text-underline-offset: 3px;
  }

  .footer-contact-link:hover {
    text-decoration: underline;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .footer-nav-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-stone);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-nav-link {
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
    padding: 5px 0;
    text-underline-offset: 3px;
    transition: color 200ms ease-out;
  }

  .footer-nav-link:hover {
    color: var(--color-stone);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-line);
  }

  .footer-bottom-inner {
    padding-top: 20px;
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
    }
  }

  .footer-legal {
    font-size: 0.8125rem;
    color: var(--color-stone);
    white-space: nowrap;
    margin: 0;
  }

  .footer-disclaimer {
    font-size: 0.8125rem;
    color: var(--color-stone);
    max-width: 55ch;
    margin: 0;
    line-height: 1.5;
  }
</style>
