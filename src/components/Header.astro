---
import config from '../../site.config';

const navLinks = [
  { label: 'Puppies', href: '/puppies' },
  { label: 'Health', href: '/health' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'Delivery', href: '/delivery' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <!-- Wordmark -->
    <a href="/" class="wordmark" aria-label={`${config.kennelName} — home`}>
      <span class="wordmark-text">{config.kennelName}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? 'nav-link--active' : ''}`}
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a href="/contact#reserve" class="btn btn-primary desktop-cta" aria-label="Reserve a puppy">
      Reserve a puppy
    </a>

    <!-- Mobile menu button -->
    <button
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="menu-toggle"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect class="bar bar-1" x="3" y="6" width="18" height="2" rx="1" fill="currentColor" />
        <rect class="bar bar-2" x="3" y="11" width="18" height="2" rx="1" fill="currentColor" />
        <rect class="bar bar-3" x="3" y="16" width="18" height="2" rx="1" fill="currentColor" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile full-screen menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation menu">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-top">
      <a href="/" class="wordmark" onclick="closeMobileMenu()">
        <span class="wordmark-text">{config.kennelName}</span>
      </a>
      <button class="menu-close" aria-label="Close menu" id="menu-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link"
          onclick="closeMobileMenu()"
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mobile-menu-cta">
      <a href="/contact#reserve" class="btn btn-primary" style="width:100%;justify-content:center" onclick="closeMobileMenu()">
        Reserve a puppy
      </a>
      {config.phone !== '{{PHONE}}' && (
        <a href={`tel:${config.phone.replace(/\D/g, '')}`} class="btn btn-ghost" style="width:100%;justify-content:center">
          Text or call us
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-warm-white);
    border-bottom: 1px solid var(--color-line);
    box-shadow: var(--shadow-bar);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }

  .wordmark {
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark-text {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .desktop-nav {
    display: none;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--color-stone);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 200ms ease-out, background-color 200ms ease-out;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background-color: var(--color-sand);
  }

  .nav-link--active {
    color: var(--color-ink);
    font-weight: 600;
  }

  .desktop-cta {
    display: none;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-ink);
    border-radius: 8px;
  }

  .menu-toggle:hover {
    background-color: var(--color-sand);
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--color-warm-white);
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease-out;
    overflow-y: auto;
  }

  .mobile-menu.open {
    opacity: 1;
    pointer-events: all;
  }

  .mobile-menu-inner {
    padding: 0 20px 40px;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 8px;
  }

  .menu-close {
    width: 44px;
    height: 44px;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .mobile-nav-link {
    display: block;
    padding: 18px 0;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color 200ms ease-out;
  }

  .mobile-nav-link[aria-current="page"] {
    color: var(--color-stone);
  }

  .mobile-menu-cta {
    margin-top: auto;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }

    .desktop-cta {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('mobile-menu');

  function openMobileMenu() {
    menu?.classList.add('open');
    menu?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeMobileMenu() {
    menu?.classList.remove('open');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  // Make closeMobileMenu available globally for inline onclick handlers
  (window as any).closeMobileMenu = closeMobileMenu;

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open');
    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  closeBtn?.addEventListener('click', closeMobileMenu);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      closeMobileMenu();
    }
  });
</script>
