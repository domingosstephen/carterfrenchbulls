---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../../site.config';

export interface Props {
  title?: string;
  description?: string;
  image?: string; // OG image URL
  noIndex?: boolean;
  /** Pass true on puppy pages to add bottom padding for the sticky bar on mobile */
  hasStickyBar?: boolean;
}

const {
  title,
  description = 'Healthy French bulldog puppies for loving homes in the USA and Canada. Family-bred for 7+ years by Sandy Carter.',
  image = '/og-default.jpg',
  noIndex = false,
  hasStickyBar = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${config.kennelName}`
  : `French bulldog puppies for sale | ${config.kennelName}, USA and Canada`;

const canonicalUrl = new URL(Astro.url.pathname, config.siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, config.siteUrl)} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, config.siteUrl)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Organization schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": config.kennelName,
      "url": config.siteUrl,
      "telephone": config.phone !== '{{PHONE}}' ? config.phone : undefined,
      "email": config.email !== '{{EMAIL}}' ? config.email : undefined,
      "description": description,
      "areaServed": ["US", "CA"],
    })} />

    <slot name="head" />
  </head>
  <body class={hasStickyBar ? 'pb-24 md:pb-0' : ''}>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
